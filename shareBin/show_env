#!/usr/bin/env bun
/**
 * τ-mux — show_env
 *
 * Environment and project diagnostics dashboard with conservative
 * secret redaction.
 *
 * Usage:
 *   show_env
 *   show_env --all
 *   show_env --compare .env
 */

import { readFileSync } from "node:fs";
import { CATPPUCCIN, fullScreenHtml, fullScreenPage } from "./lib/full-screen";
import { parseArgs } from "./lib/cli";
import { escapeHtml } from "./lib/escape";
import { compareEnvFile, parseEnvFile, pathDiagnostics, redactValue, selectedEnvRows } from "./lib/env-diagnostics";
import { runText } from "./lib/subprocess";

let parsed;
try {
  parsed = parseArgs(process.argv.slice(2), {
    schema: [
      { name: "all", long: "all", kind: "boolean", default: false },
      { name: "compare", long: "compare", kind: "string", default: "" },
      { name: "json", long: "json", kind: "boolean", default: false },
    ] as const,
  });
} catch (err) {
  console.error(`show_env: ${(err as Error).message}`);
  process.exit(1);
}

const flags = parsed.flags;
const versions = await collectVersions();
const pathRows = await pathDiagnostics();
const project = await collectProject();
const envRows = selectedEnvRows(process.env, flags.all);
const comparison = flags.compare ? loadComparison(flags.compare) : null;

if (flags.json) {
  console.log(JSON.stringify({ versions, pathRows, project, envRows, comparison }, null, 2));
  process.exit(0);
}

fullScreenHtml({
  render: () => fullScreenPage({
    tag: { label: "ENV", color: CATPPUCCIN.sky },
    title: escapeHtml(process.cwd()),
    subtitle: `${envRows.length} env vars · ${pathRows.length} PATH entries`,
    body: `${versionCards()}${projectPanel()}${pathPanel()}${envPanel()}${comparisonPanel()}`,
    extraCss: css(),
  }),
});

async function collectVersions(): Promise<Record<string, string>> {
  const command = async (name: string, cmd: string[]) => {
    const result = await runText(cmd, { timeoutMs: 1500 });
    return [name, result.exitCode === 0 ? result.stdout.trim().split("\n")[0] ?? "" : "not found"] as const;
  };
  const entries = await Promise.all([
    Promise.resolve(["bun", Bun.version] as const),
    Promise.resolve(["node", process.version] as const),
    command("git", ["git", "--version"]),
    command("npm", ["npm", "--version"]),
    command("pnpm", ["pnpm", "--version"]),
    command("yarn", ["yarn", "--version"]),
  ]);
  return Object.fromEntries(entries);
}

async function collectProject(): Promise<Record<string, unknown>> {
  const cwd = process.cwd();
  const packageJson = await readJsonIfExists(`${cwd}/package.json`);
  const lockfiles = [];
  for (const file of ["bun.lock", "bun.lockb", "package-lock.json", "pnpm-lock.yaml", "yarn.lock"]) {
    if (await existsFile(`${cwd}/${file}`)) lockfiles.push(file);
  }
  const branch = await runText(["git", "branch", "--show-current"], { timeoutMs: 1500, cwd });
  const status = await runText(["git", "status", "--short"], { timeoutMs: 1500, cwd });
  return {
    packageName: typeof packageJson?.name === "string" ? packageJson.name : "",
    packageVersion: typeof packageJson?.version === "string" ? packageJson.version : "",
    scripts: packageJson?.scripts && typeof packageJson.scripts === "object" ? Object.keys(packageJson.scripts as Record<string, unknown>).sort() : [],
    lockfiles,
    gitBranch: branch.exitCode === 0 ? branch.stdout.trim() : "",
    gitDirtyLines: status.exitCode === 0 ? status.stdout.trim().split("\n").filter(Boolean).length : null,
  };
}

function loadComparison(path: string): { path: string; fileOnly: string[]; shared: string[]; envOnlyCount: number; rows: { key: string; fileValue: string; envValue: string }[]; error?: string } {
  try {
    const fileEnv = parseEnvFile(readFileSync(path, "utf8"));
    const cmp = compareEnvFile(fileEnv);
    return {
      path,
      fileOnly: cmp.fileOnly,
      shared: cmp.shared,
      envOnlyCount: cmp.envOnly.length,
      rows: cmp.fileKeys.map((key) => ({ key, fileValue: redactValue(key, fileEnv[key]), envValue: redactValue(key, process.env[key]) })),
    };
  } catch (err) {
    return { path, fileOnly: [], shared: [], envOnlyCount: 0, rows: [], error: (err as Error).message };
  }
}

function versionCards(): string {
  return `<section class="cards">${Object.entries(versions).map(([name, value]) => `<div class="card"><strong>${escapeHtml(value || "—")}</strong><span>${escapeHtml(name)}</span></div>`).join("")}</section>`;
}

function projectPanel(): string {
  const scripts = (project.scripts as string[]).map((script) => `<span class="pill">${escapeHtml(script)}</span>`).join(" ") || `<span class="muted">none</span>`;
  const locks = (project.lockfiles as string[]).map((file) => `<span class="pill accent">${escapeHtml(file)}</span>`).join(" ") || `<span class="muted">none</span>`;
  return `<section class="panel"><h2>Project</h2><div class="kv">
    <div><b>package</b><span>${escapeHtml(String(project.packageName || "—"))} ${escapeHtml(String(project.packageVersion || ""))}</span></div>
    <div><b>lockfiles</b><span>${locks}</span></div>
    <div><b>scripts</b><span>${scripts}</span></div>
    <div><b>git</b><span>${escapeHtml(String(project.gitBranch || "not a git repo"))} · ${project.gitDirtyLines === null ? "unknown" : `${project.gitDirtyLines} changed lines`}</span></div>
  </div></section>`;
}

function pathPanel(): string {
  const rows = pathRows.map((row) => `<tr class="${row.duplicate || !row.exists ? "warn" : ""}"><td>${row.index + 1}</td><td>${escapeHtml(row.path)}</td><td>${row.exists ? "ok" : "missing"}</td><td>${row.duplicate ? "duplicate" : ""}</td></tr>`).join("");
  return `<section class="panel"><h2>PATH</h2><div class="table-scroll"><table><thead><tr><th>#</th><th>Entry</th><th>Exists</th><th>Note</th></tr></thead><tbody>${rows}</tbody></table></div></section>`;
}

function envPanel(): string {
  const rows = envRows.map((row) => `<tr><td>${escapeHtml(row.key)}</td><td>${escapeHtml(row.value)}</td></tr>`).join("");
  return `<section class="panel"><h2>Environment <input class="filter" placeholder="filter…"></h2><div class="table-scroll"><table class="env-table"><tbody>${rows}</tbody></table></div></section>${filterScript()}`;
}

function comparisonPanel(): string {
  if (!comparison) return "";
  if (comparison.error) return `<section class="panel"><h2>.env compare</h2><div class="error">${escapeHtml(comparison.error)}</div></section>`;
  const rows = comparison.rows.map((row) => `<tr><td>${escapeHtml(row.key)}</td><td>${escapeHtml(row.fileValue)}</td><td>${escapeHtml(row.envValue || "(missing)")}</td></tr>`).join("");
  return `<section class="panel"><h2>.env compare — ${escapeHtml(comparison.path)}</h2><p class="note">${comparison.shared.length} shared · ${comparison.fileOnly.length} only in file · ${comparison.envOnlyCount} only in environment</p><div class="table-scroll"><table><thead><tr><th>Key</th><th>File</th><th>Process env</th></tr></thead><tbody>${rows}</tbody></table></div></section>`;
}

async function existsFile(path: string): Promise<boolean> {
  try {
    const stat = await Bun.file(path).stat();
    return stat.isFile();
  } catch {
    return false;
  }
}

async function readJsonIfExists(path: string): Promise<Record<string, unknown> | null> {
  if (!(await existsFile(path))) return null;
  try {
    return JSON.parse(await Bun.file(path).text()) as Record<string, unknown>;
  } catch {
    return null;
  }
}

function filterScript(): string {
  return `<script>(function(){const input=document.querySelector('.filter');input?.addEventListener('input',()=>{const q=input.value.toLowerCase();for(const tr of document.querySelectorAll('.env-table tr'))tr.hidden=!(tr.textContent||'').toLowerCase().includes(q);});})();</script>`;
}

