.card { padding: 13px; border: 1px solid ${CATPPUCCIN.surface0}; border-radius: 14px; background: ${CATPPUCCIN.mantle}; }
.card strong { display: block; font-size: 16px; color: ${CATPPUCCIN.text}; overflow-wrap: anywhere; }
.card span { color: ${CATPPUCCIN.overlay1}; text-transform: uppercase; font-size: 10px; letter-spacing: 0.08em; }
.panel { border: 1px solid ${CATPPUCCIN.surface0}; border-radius: 14px; overflow: hidden; background: rgba(24,24,37,0.72); margin-top: 16px; }
.panel h2 { margin: 0; padding: 11px 14px; color: ${CATPPUCCIN.subtext1}; font-size: 12px; text-transform: uppercase; border-bottom: 1px solid ${CATPPUCCIN.surface0}; display: flex; justify-content: space-between; gap: 12px; }
.filter { border: 1px solid ${CATPPUCCIN.surface1}; background: ${CATPPUCCIN.crust}; color: ${CATPPUCCIN.text}; border-radius: 8px; padding: 5px 8px; font: inherit; text-transform: none; }
.kv { display: grid; gap: 1px; }
.kv div { display: grid; grid-template-columns: 140px minmax(0,1fr); gap: 12px; padding: 9px 14px; border-bottom: 1px solid rgba(255,255,255,0.035); }
.kv b { color: ${CATPPUCCIN.pink}; }
.pill { display: inline-flex; margin: 2px 4px 2px 0; padding: 2px 7px; border-radius: 999px; background: ${CATPPUCCIN.surface0}; color: ${CATPPUCCIN.subtext1}; }
.pill.accent { color: ${CATPPUCCIN.green}; }
.table-scroll { overflow: auto; max-height: 340px; }
table { width: 100%; border-collapse: collapse; }
th { text-align: left; color: ${CATPPUCCIN.subtext1}; background: ${CATPPUCCIN.mantle}; position: sticky; top: 0; padding: 8px 10px; }
td { padding: 7px 10px; border-bottom: 1px solid rgba(255,255,255,0.035); vertical-align: top; overflow-wrap: anywhere; }
td:first-child { color: ${CATPPUCCIN.pink}; font-weight: 700; }
