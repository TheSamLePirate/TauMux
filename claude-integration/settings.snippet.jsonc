// Drop-in hook blocks for ~/.claude/settings.json — ht-bridge v2
// (august-plan M1). JSONC for readability; strip comments before pasting,
// or hand-merge into your existing `hooks` object.
//
// Every entry is the same shape: `bun …/ht-bridge/src/index.ts <event>`.
// All events are optional — install the subset you want. The four v1
// events (prompt / stop / notify-idle / notify-permission) keep their
// names, so an existing install only needs the NEW blocks added.
//
// Also install the statusline (cost / context / rate limits / session
// title — this is the data plane, the hooks are only the event plane):
//
//   "statusLine": { "type": "command", "command": "ht claude statusline" }
{
  "statusLine": {
    "type": "command",
    "command": "ht claude statusline"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts stop"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts stop-failure"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts session-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts session-end"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts subagent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts subagent-stop"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts pre-compact"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts post-compact"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts cwd-changed"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts task-created"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts task-completed"
          }
        ]
      }
    ],
    // OPT-IN — remote approvals (august-plan M2 / WS3). Wiring this block
    // routes permission prompts to a τ-mux modal (and Telegram when
    // configured): Allow / Deny / "Answer in terminal". If τ-mux is not
    // running, the modal times out, or you pick "terminal", Claude Code
    // falls back to its own prompt — the hook can only ADD an answer
    // path. Escape hatch without unwiring: HT_CLAUDE_APPROVALS=0.
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts permission-request",
            "timeout": 600
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts notify-idle"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/olivierveinand/.claude/scripts/ht-bridge/src/index.ts notify-permission"
          }
        ]
      }
    ]
  }
}
